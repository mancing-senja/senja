{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "env": {
    "SENJA_AI_MODEL": "muse-spark-1.2-contributor"
  },
  "rewrites": [
    {
      "source": "/room",
      "destination": "/api/room"
    }
  ]
}
